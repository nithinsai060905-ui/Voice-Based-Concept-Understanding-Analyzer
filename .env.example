# Voice-Based Concept Understanding Analyzer (VBCUA) Environment Settings

# Google Gemini API Key for generating intelligent feedback (Required for AI features)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Secret key for JWT signing & session cookies validation (Change in production!)
SECRET_KEY=generate_a_long_random_hex_string_here_e.g_9b8c7d6e5f

# SQLite Database connection URL (Relative to project root)
DATABASE_URL=sqlite:///database/analyzer.db

# Whisper model to use for Speech-To-Text (tiny, base, small, medium, large)
WHISPER_MODEL=tiny

# Silence threshold in dB for pause detection (lower values make detection more sensitive, e.g. -35)
SILENCE_THRESHOLD_DB=-35

# Application listening port configurations (Optional)
BACKEND_PORT=8000
FRONTEND_PORT=8501
